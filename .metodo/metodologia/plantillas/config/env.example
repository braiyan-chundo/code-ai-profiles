# Catálogo de configuración de {{PROYECTO}}. Es el ÚNICO .env que se commitea en este repo.
#
# Reglas (configuracion-del-codigo.md):
#   - Toda variable lleva encima su ficha: [SECRET] o [PUBLICO] · para qué · requerida u opcional · apps.
#   - [SECRET] va vacía aquí; su valor real vive en .env.local (desarrollo) o en el gestor del entorno.
#   - [SECRET] nunca lleva prefijo público (VITE_, NEXT_PUBLIC_, NUXT_PUBLIC_, PUBLIC_, EXPO_PUBLIC_).
#   - El código lee estas variables solo desde su módulo de configuración, nunca de forma suelta.
#   - En desarrollo, los secretos se generan: openssl rand -base64 32

{{#SI_HAY_SERVIDOR}}
# ── Servidor ─────────────────────────────────────────────────────────────────
# [PUBLICO] Puerto del servidor de desarrollo · requerida
PORT=3000
# [SECRET] Cadena de conexión a la base de datos · requerida
DATABASE_URL=
# [SECRET] Secreto para firmar sesiones o JWT · requerida
AUTH_SECRET=
# [PUBLICO] Orígenes permitidos por CORS, separados por coma · requerida
CORS_ORIGINS=http://localhost:5173

{{/SI_HAY_SERVIDOR}}
{{#SI_HAY_APP}}
# ── Aplicación ───────────────────────────────────────────────────────────────
{{#SI_PROYECTO_CON_API}}
# [PUBLICO] URL base de la API que consume la app · requerida
VITE_API_URL=http://localhost:3000
{{/SI_PROYECTO_CON_API}}
# [PUBLICO] URL pública del sitio (enlaces canónicos, compartir) · opcional
VITE_SITE_URL=http://localhost:5173
{{/SI_HAY_APP}}
