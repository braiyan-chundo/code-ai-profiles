{
  "name": "code-ai-profiles",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "packageManager": "pnpm@12.8.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "build": "tsc && vite build",
    "release:version": "node scripts/release-version.mjs",
    "release:check": "node scripts/release-version.mjs --check",
    "test:release": "node --test scripts/release-version.test.mjs",
    "test:graph": "node --test scripts/graphify-memory.test.mjs",
    "test:scan": "node --test tests/scan-controller.test.ts",
    "test:update": "node --test tests/source-update-controller.test.ts",
    "test:format": "node --test tests/format.test.ts",
    "test:appearance": "node --test tests/appearance.test.ts",
    "test:dashboard": "node --test tests/dashboard-state.test.ts",
    "test:messages": "node --test tests/result-messages.test.ts",
    "test:permissions": "node --test tests/permissions.test.ts",
    "test:projects": "node --test tests/projects.test.ts",
    "test:ui": "node --test tests/ui-isolation.test.ts",
    "graph:build": "node scripts/graphify.mjs build",
    "graph:update": "node scripts/graphify.mjs update",
    "graph:check": "node scripts/graphify.mjs check",
    "build:linux": "tauri build --bundles deb,appimage",
    "build:macos": "tauri build --bundles app,dmg",
    "build:windows": "tauri build --bundles msi,nsis",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@shadcn/react": "0.3.1",
    "@tauri-apps/api": "^2.0.0",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.5.0",
    "date-fns": "4.4.0",
    "embla-carousel-react": "8.6.0",
    "input-otp": "1.5.0",
    "lucide-react": "1.62.0",
    "radix-ui": "1.8.1",
    "react": "^19.0.0",
    "react-day-picker": "10.0.2",
    "react-dom": "^19.0.0",
    "react-markdown": "10.1.0",
    "react-resizable-panels": "4.15.0",
    "react-router": "^7.18.4",
    "recharts": "3.8.0",
    "remark-gfm": "4.0.1",
    "shiki": "4.5.0",
    "sonner": "2.0.8",
    "vaul": "1.1.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "shadcn": "4.22.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "~5.7.0",
    "vite": "^6.0.0"
  }
}
