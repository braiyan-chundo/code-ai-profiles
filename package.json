{
  "name": "code-ai-profiles",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "build": "tsc && vite build",
    "graph:build": "node scripts/graphify.mjs build",
    "graph:update": "node scripts/graphify.mjs update",
    "graph:check": "node scripts/graphify.mjs check",
    "build:linux": "tauri build --bundles deb,appimage",
    "build:macos": "tauri build --bundles app,dmg",
    "build:windows": "tauri build --bundles msi,nsis",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tauri-apps/api": "^2.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "~5.7.0",
    "vite": "^6.0.0"
  }
}
