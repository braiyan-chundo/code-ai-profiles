{
  "name": "code-ai-profiles",
  "private": true,
  "version": "0.2.2",
  "type": "module",
  "packageManager": "pnpm@12.8.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "build": "tsc && vite build",
    "release:version": "node scripts/release-version.mjs",
    "release:check": "node scripts/release-version.mjs --check",
    "test:release": "node --test scripts/release-version.test.mjs",
    "test:graph": "node --test scripts/graphify-memory.test.mjs",
    "test:scan": "node --test tests/scan-controller.test.ts",
    "test:update": "node --test tests/source-update-controller.test.ts",
    "test:format": "node --test tests/format.test.ts",
    "test:appearance": "node --test tests/appearance.test.ts",
    "test:dashboard": "node --test tests/dashboard-state.test.ts",
    "test:messages": "node --test tests/result-messages.test.ts",
    "graph:build": "node scripts/graphify.mjs build",
    "graph:update": "node scripts/graphify.mjs update",
    "graph:check": "node scripts/graphify.mjs check",
    "build:linux": "tauri build --bundles deb,appimage",
    "build:macos": "tauri build --bundles app,dmg",
    "build:windows": "tauri build --bundles msi,nsis",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tauri-apps/api": "^2.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.18.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "~5.7.0",
    "vite": "^6.0.0"
  }
}
