{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Edit(/hu/INDEX.md)",
      "Edit(/AGENTS.md)",
      "Edit(/.metodo/metodologia/**)",
      "Edit(/.claude/agents/**)",
      "Edit(/.claude/commands/**)",
      "Edit(/.claude/hooks/**)",
      "Read(**/.env.production)",
      "Read(**/.env.prod)",
      "Read(**/.env.production.local)",
      "Bash(git push:*)",
      "Bash(git push)",
      "Bash(gh release:*)",
      "Bash(gh pr create:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|Read|Grep|Glob|Agent|Skill|WebFetch|WebSearch",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guarda.mjs\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/fin-de-turno.mjs\""
          }
        ]
      }
    ]
  }
}
